{
  "name": "style-system",
  "version": "1.0.0",
  "description": "Clearline 7 design token parser and distributor",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
  ".": {
    "import": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "require": "./dist/index.js"
  }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --watch --format cjs,esm --dts",
    "clean": "rm -rf dist"
  },
  "keywords": ["design-tokens", "tailwind", "clearline7"],
  "author": "Vincent Radford",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}